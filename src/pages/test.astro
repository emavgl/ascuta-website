---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Ascuta bubble – demo"
  description="An animated demo of the Ascuta floating bubble dictating into any app."
  noindex
>
  <section class="page-header"><div class="container"><p class="eyebrow">Demo</p><h1>Dictate anywhere with the bubble.</h1><p class="lede">Tap the Ascuta bubble, speak, and your words land in the field you are already using — inside any app.</p></div></section>

  <section class="section"><div class="container demo-stage">
    <div class="phone">
      <div class="screen">
        <div class="statusbar"><span>9:41</span><span class="status-icons"><i class="dot"></i><i class="dot"></i><i class="dot"></i>&#9632;</span></div>
        <div class="app">
          <div class="app-header"><span class="avatar">A</span><span class="app-name">Anna</span><span class="app-dots">&#8942;</span></div>
          <div class="chat">
            <div class="msg in">Are we still on for tomorrow?</div>
            <div class="msg out" id="sent-msg" hidden>Yes, see you at eight!</div>
          </div>
          <div class="composer">
            <div class="field"><span class="field-text" id="field-text"></span><span class="caret"></span></div>
            <button class="send" type="button" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M3 20.5 21 12 3 3.5v6l12 2.5-12 2.5z"/></svg></button>
          </div>
          <div class="keyboard" aria-hidden="true">
            <div class="key-row"><span>Q</span><span>W</span><span>E</span><span>R</span><span>T</span><span>Y</span><span>U</span><span>I</span><span>O</span><span>P</span></div>
            <div class="key-row"><span>A</span><span>S</span><span>D</span><span>F</span><span>G</span><span>H</span><span>J</span><span>K</span><span>L</span></div>
            <div class="key-row"><span class="wide">&#8679;</span><span>Z</span><span>X</span><span>C</span><span>V</span><span>B</span><span>N</span><span>M</span><span class="wide">&#9003;</span></div>
            <div class="key-row"><span class="wide">?123</span><span class="space">en</span><span class="wide">&#9166;</span></div>
          </div>
        </div>

        <div class="bubble-wrap" id="bubble-wrap">
          <svg class="bubble-ring" viewBox="0 0 56 56" width="56" height="56">
            <circle class="progress" cx="28" cy="28" r="26" fill="none" stroke="#FF5A00" stroke-width="3.5" stroke-linecap="round" transform="rotate(-90 28 28)"></circle>
            <circle class="spinner" cx="28" cy="28" r="26" fill="none" stroke="#FF5A00" stroke-width="3.5" stroke-linecap="round"></circle>
          </svg>
          <span class="bubble" id="bubble"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="#FFFFFF" d="M12,14c1.66,0 3,-1.34 3,-3V5c0,-1.66 -1.34,-3 -3,-3S9,3.34 9,5v6C9,12.66 10.34,14 12,14zM17.3,11c0,3 -2.54,5.1 -5.3,5.1S6.7,14 6.7,11H5c0,3.41 2.72,6.23 6,6.72V21h2v-3.28c3.28,-0.48 6,-3.3 6,-6.72H17.3z"/></svg></span>
        </div>
        <div class="transcript" id="transcript" hidden></div>
        <div class="feedback" id="feedback" hidden></div>
      </div>
    </div>

    <div class="demo-controls"><button class="button button-secondary" id="replay" type="button">Replay</button><span class="demo-caption">The floating bubble stays over any app.</span></div>
  </div></section>

  <script>
    const bubble = document.getElementById('bubble');
    const wrap = document.getElementById('bubble-wrap');
    const feedback = document.getElementById('feedback');
    const fieldText = document.getElementById('field-text');
    const transcript = document.getElementById('transcript');
    const sentMsg = document.getElementById('sent-msg');
    const replay = document.getElementById('replay');

    const ringEl = document.querySelector('.bubble-ring .progress');
    const ring = ringEl instanceof SVGCircleElement ? ringEl : null;

    const C = 2 * Math.PI * 26;
    const RAW = 'ehm yes see you at eight';
    const CLEANED =
      '<span class="fix">Y</span>es<span class="fix">,</span> see you at eight<span class="fix">!</span>';
    let generation = 0;

    if (ring) {
      ring.style.strokeDasharray = String(C);
      ring.style.strokeDashoffset = String(C);
    }

    const wait = (ms: number, gen: number) =>
      new Promise<boolean>((resolve) => setTimeout(() => resolve(gen === generation), ms));

    function setFeedback(text: string) {
      if (!feedback) return;
      feedback.textContent = text;
      feedback.hidden = false;
    }

    async function typeRaw(gen: number, duration: number) {
      if (!transcript) return;
      transcript.textContent = '';
      const step = Math.max(30, duration / RAW.length);
      for (let i = 1; i <= RAW.length; i++) {
        if (gen !== generation) return;
        transcript.textContent = RAW.slice(0, i);
        await wait(step, gen);
      }
    }

    async function run(gen: number) {
      if (!bubble || !wrap || !fieldText) return;
      bubble.className = 'bubble';
      wrap.className = 'bubble-wrap';
      fieldText.textContent = '';
      if (transcript) transcript.hidden = true;
      if (sentMsg) sentMsg.hidden = true;
      if (feedback) feedback.hidden = true;
      if (ring) {
        ring.style.transition = 'none';
        ring.style.strokeDashoffset = String(C);
      }
      if (!(await wait(900, gen))) return;

      // Tap: recording. The ring grows clockwise, like the app's time ring.
      bubble.classList.add('recording');
      wrap.classList.add('live');
      setFeedback('Listening…');
      if (transcript) transcript.hidden = false;
      if (ring) {
        requestAnimationFrame(() => {
          if (!ring) return;
          ring.style.transition = 'stroke-dashoffset 2.8s linear';
          ring.style.strokeDashoffset = '0';
        });
      }
      await typeRaw(gen, 2600);
      if (gen !== generation) return;

      // Stop: post-processing. Show the filler being removed, then the cleanup.
      bubble.classList.remove('recording');
      wrap.classList.remove('live');
      wrap.classList.add('busy');
      if (ring) {
        ring.style.transition = 'none';
        ring.style.strokeDashoffset = String(C);
      }
      setFeedback('Cleaning up…');
      if (transcript) transcript.innerHTML = '<span class="fill">ehm </span>yes see you at eight';
      if (!(await wait(800, gen))) return;
      if (transcript) transcript.hidden = true;
      // The cleaned text — not the raw transcript — lands in the field.
      fieldText.innerHTML = CLEANED;
      if (!(await wait(1000, gen))) return;

      // Done: cleaned text sits in the field.
      wrap.classList.remove('busy');
      setFeedback('Done');
      if (!(await wait(900, gen))) return;

      // Send.
      if (feedback) feedback.hidden = true;
      fieldText.textContent = '';
      if (sentMsg) sentMsg.hidden = false;
      if (!(await wait(2400, gen))) return;
    }

    async function loop() {
      const gen = ++generation;
      while (gen === generation) {
        await run(gen);
        if (gen !== generation) break;
        if (!(await wait(400, gen))) break;
      }
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (fieldText) fieldText.innerHTML = CLEANED;
    } else {
      loop();
    }

    replay?.addEventListener('click', () => loop());
  </script>

  <style>
    .demo-stage { display: flex; flex-direction: column; align-items: center; gap: 22px; }
    .demo-controls { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; justify-content: center; }
    .demo-caption { color: var(--muted); font-size: 14px; }

    .phone { width: 320px; height: 660px; padding: 9px; border-radius: 42px; background: #10151c; box-shadow: 0 24px 60px rgba(5, 25, 35, .28), inset 0 0 0 2px #2a3340; }
    .screen { position: relative; width: 100%; height: 100%; border-radius: 34px; overflow: hidden; background: #eef2f6; font-family: Inter, system-ui, sans-serif; }
    .statusbar { display: flex; justify-content: space-between; align-items: center; padding: 9px 18px 5px; font-size: 11px; font-weight: 700; color: #051923; }
    .status-icons { display: inline-flex; align-items: center; gap: 3px; }
    .status-icons .dot { width: 4px; height: 4px; border-radius: 50%; background: currentColor; display: inline-block; }

    .app { position: absolute; inset: 26px 0 0; display: flex; flex-direction: column; }
    .app-header { display: flex; align-items: center; gap: 10px; padding: 8px 14px 12px; background: #fff; border-bottom: 1px solid #e2e6eb; }
    .avatar { width: 30px; height: 30px; border-radius: 50%; background: var(--primary); color: #fff; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .app-name { font-size: 15px; font-weight: 700; color: #051923; }
    .app-dots { margin-left: auto; color: #8a94a2; font-size: 16px; }
    .chat { flex: 1; padding: 14px 14px 8px; display: flex; flex-direction: column; gap: 8px; }
    .msg { max-width: 78%; padding: 9px 13px; border-radius: 16px; font-size: 14px; line-height: 1.35; }
    .msg.in { align-self: flex-start; background: #fff; color: #051923; border-bottom-left-radius: 4px; box-shadow: 0 1px 2px rgba(5,25,35,.06); }
    .msg.out { align-self: flex-end; background: var(--primary); color: #fff; border-bottom-right-radius: 4px; }

    .composer { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: #fff; border-top: 1px solid #e2e6eb; }
    .field { flex: 1; min-height: 38px; display: flex; align-items: center; padding: 0 14px; border-radius: 19px; background: #f2f5f8; font-size: 14px; color: #051923; }
    .field-text { white-space: nowrap; overflow: hidden; }
    .caret { width: 1.5px; height: 17px; margin-left: 1px; background: var(--primary); animation: blink 1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    .send { width: 38px; height: 38px; border: 0; border-radius: 50%; background: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; }

    .keyboard { background: #d7dde4; padding: 7px 5px 12px; display: flex; flex-direction: column; gap: 6px; }
    .key-row { display: flex; gap: 4px; justify-content: center; }
    .key-row span { flex: 1; min-width: 0; height: 32px; border-radius: 5px; background: #fff; color: #051923; font-size: 12px; font-weight: 600; display: flex; align-items: center; justify-content: center; box-shadow: 0 1px 0 rgba(5,25,35,.18); }
    .key-row .wide { flex: 1.4; background: #c3ccd6; font-weight: 700; }
    .key-row .space { flex: 4.5; }

    .transcript .fill { color: #ff9b9b; text-decoration: line-through; }
    .field-text .fix { color: #1a7f37; font-weight: 800; animation: fixpop 1s ease; }
    @keyframes fixpop { 0% { background: rgba(26,127,55,.22); } 100% { background: transparent; } }

    .bubble-wrap { position: absolute; top: 50%; right: 8px; width: 56px; height: 56px; transform: translateY(-50%); display: flex; align-items: center; justify-content: center; }
    .bubble-ring { position: absolute; inset: 0; overflow: visible; }
    .spinner { display: none; }
    .bubble-wrap.busy .progress { display: none; }
    .bubble-wrap.busy .spinner { display: block; }
    .bubble-wrap.busy .bubble-ring { animation: spin 1s linear infinite; }
    .bubble { position: relative; width: 44px; height: 44px; border-radius: 50%; background: rgba(5,25,35,.87); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(5,25,35,.35); transition: background .18s ease; }
    .bubble.recording { background: rgba(239,68,68,.87); }
    .bubble.busy { background: rgba(5,25,35,.87); }
    .bubble-wrap.live .bubble::after { content: ""; position: absolute; inset: -10px; border-radius: 50%; background: rgba(239,68,68,.28); animation: pulse 1.4s ease-out infinite; }
    @keyframes pulse { 0% { transform: scale(.7); opacity: .7; } 100% { transform: scale(1.25); opacity: 0; } }
    @keyframes spin { to { transform: rotate(360deg); } }

    .feedback { position: absolute; top: 50%; right: 66px; transform: translateY(-190%); max-width: 190px; padding: 7px 12px; border-radius: 16px; background: rgba(5,25,35,.93); color: #fff; font-size: 12.5px; line-height: 1.3; box-shadow: 0 4px 12px rgba(5,25,35,.28); }
    .transcript { position: absolute; top: 50%; right: 66px; transform: translateY(18%); width: 200px; padding: 9px 13px; border-radius: 14px; background: rgba(5,25,35,.86); color: #fff; font-size: 12.5px; line-height: 1.5; box-shadow: 0 4px 12px rgba(5,25,35,.28); }

    @media (max-width: 420px) { .phone { width: 280px; height: 580px; } }
    @media (prefers-reduced-motion: reduce) { .bubble-wrap.live .bubble::after, .bubble-wrap.busy .bubble-ring { animation: none; } }
  </style>
</Layout>
