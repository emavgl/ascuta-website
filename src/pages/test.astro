---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Ascuta bubble – demo"
  description="An animated demo of the Ascuta floating bubble dictating into any app."
  noindex
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Private voice typing for Android</p>
        <h1>Turn your voice into <span class="hero-accent">words that stay yours.</span></h1>
        <p class="lede">Ascuta puts dictation into the text field you are already using. Tap the bubble, speak naturally, and keep moving.</p>
        <div class="actions"><a class="button button-primary" href="https://play.google.com/store/apps/details?id=eu.viglianisi.ascuta" target="_blank" rel="noopener">Download on Android</a><a class="button button-secondary" href={`${base}docs`}>Read the docs</a></div>
      </div>

      <div class="hero-visual">
        <div class="phone">
          <div class="screen">
            <div class="statusbar"><span>9:41</span><span class="status-icons"><i class="dot"></i><i class="dot"></i><i class="dot"></i>&#9632;</span></div>
            <div class="app">
              <div class="app-header"><span class="avatar">A</span><span class="app-name">Anna</span><span class="app-dots">&#8942;</span></div>
              <div class="chat">
                <div class="msg in">Are we still on for tomorrow?</div>
                <div class="msg out" id="sent-msg" hidden>Yes, see you at eight!</div>
              </div>
              <div class="composer">
                <div class="field"><span class="field-text" id="field-text"></span><span class="caret"></span></div>
                <button class="send" type="button" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M3 20.5 21 12 3 3.5v6l12 2.5-12 2.5z"/></svg></button>
              </div>
              <div class="keyboard" aria-hidden="true">
                <div class="key-row"><span>Q</span><span>W</span><span>E</span><span>R</span><span>T</span><span>Y</span><span>U</span><span>I</span><span>O</span><span>P</span></div>
                <div class="key-row"><span>A</span><span>S</span><span>D</span><span>F</span><span>G</span><span>H</span><span>J</span><span>K</span><span>L</span></div>
                <div class="key-row"><span class="wide">&#8679;</span><span>Z</span><span>X</span><span>C</span><span>V</span><span>B</span><span>N</span><span>M</span><span class="wide">&#9003;</span></div>
                <div class="key-row"><span class="wide">?123</span><span class="space">en</span><span class="wide">&#9166;</span></div>
              </div>
            </div>

            <div class="transcript" id="transcript" hidden></div>
            <div class="feedback" id="feedback" hidden></div>
            <div class="bubble-wrap" id="bubble-wrap">
              <svg class="bubble-ring" viewBox="0 0 56 56" width="56" height="56">
                <circle class="progress" cx="28" cy="28" r="26" fill="none" stroke="#FF5A00" stroke-width="3.5" stroke-linecap="round" transform="rotate(-90 28 28)"></circle>
                <circle class="spinner" cx="28" cy="28" r="26" fill="none" stroke="#FF5A00" stroke-width="3.5" stroke-linecap="round"></circle>
              </svg>
              <span class="bubble" id="bubble"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="#FFFFFF" d="M12,14c1.66,0 3,-1.34 3,-3V5c0,-1.66 -1.34,-3 -3,-3S9,3.34 9,5v6C9,12.66 10.34,14 12,14zM17.3,11c0,3 -2.54,5.1 -5.3,5.1S6.7,14 6.7,11H5c0,3.41 2.72,6.23 6,6.72V21h2v-3.28c3.28,-0.48 6,-3.3 6,-6.72H17.3z"/></svg></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft flow-section" id="flow-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Nothing leaves your phone</p>
        <h2>From your voice to polished text, entirely on-device.</h2>
        <p>Ascuta runs open-source AI models locally: one for speech-to-text, one for cleanup. Your audio and text never touch a server.</p>
      </div>

      <div class="flow" id="flow">
        <div class="flow-main">
          <article class="flow-node voice-node" data-step="0">
            <div class="flow-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path fill="currentColor" d="M12,14c1.66,0 3,-1.34 3,-3V5c0,-1.66 -1.34,-3 -3,-3S9,3.34 9,5v6C9,12.66 10.34,14 12,14zM17.3,11c0,3 -2.54,5.1 -5.3,5.1S6.7,14 6.7,11H5c0,3.41 2.72,6.23 6,6.72V21h2v-3.28c3.28,-0.48 6,-3.3 6,-6.72H17.3z"/></svg></div>
            <h3>Your voice</h3>
            <p>You tap the bubble and speak.</p>
            <div class="wave-bubble" id="wave-box">
              <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
              <span class="wave-text" id="wave-text"></span>
            </div>
          </article>

          <div class="flow-link one" aria-hidden="true"><svg viewBox="0 0 140 24" preserveAspectRatio="none"><path class="wire" d="M0 12 H140" /><path class="send-line" d="M0 12 H140" /></svg></div>

          <article class="flow-node phone-node" data-step="1">
            <div class="phone-mini">
              <div class="pm-notch"></div>
              <div class="pm-screen">
                <div class="pm-model">
                  <span class="pm-icon"><svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M4 5h16v2H4V5zm0 6h16v2H4v-2zm0 6h10v2H4v-2z"/></svg></span>
                  <span><strong>Speech-to-text</strong><small>Whisper · Parakeet</small></span>
                </div>
                <div class="pm-model">
                  <span class="pm-icon"><svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M9.8 15.9 9 18.75l-.8-2.85a4.5 4.5 0 0 0-3.1-3.09L2.25 12l2.85-.81a4.5 4.5 0 0 0 3.1-3.1L9 5.25l.8 2.85a4.5 4.5 0 0 0 3.1 3.09L15.75 12l-2.85.81a4.5 4.5 0 0 0-3.1 3.09z"/></svg></span>
                  <span><strong>Post-processing</strong><small>Gemma</small></span>
                </div>
                <div class="pm-badge"><span class="flow-tag local">On-device</span></div>
              </div>
            </div>
            <h3>Processed on your phone</h3>
            <p>Both models run locally, inside the app.</p>
          </article>

          <div class="flow-link two" aria-hidden="true"><svg viewBox="0 0 140 24" preserveAspectRatio="none"><path class="wire" d="M0 12 H140" /><path class="send-line" d="M0 12 H140" /></svg></div>

          <article class="flow-node field-node" data-step="2">
            <div class="flow-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path fill="currentColor" d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7zm3 4h.01M11 11h.01M15 11h.01M7 14.5h10"/></svg></div>
            <h3>Text in the field</h3>
            <p>Clean text lands where you were typing.</p>
            <div class="field-mock">“<span class="fix">Y</span>es<span class="fix">,</span> see you at eight<span class="fix">!</span>”</div>
          </article>
        </div>

        <div class="flow-cloud" data-step="3" aria-hidden="true">
          <span class="cloud-icon"><svg viewBox="0 0 24 24" width="26" height="26"><path fill="currentColor" d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.33-7.26 3 3 0 0 0-3.76-3.85 5.25 5.25 0 0 0-10.23 2.33A4.5 4.5 0 0 0 2.25 15z"/></svg></span>
          <span class="cloud-label">Cloud server</span>
          <span class="cloud-x">✕</span>
        </div>

        <div class="flow-stage" id="flow-stage" aria-live="polite">Idle</div>
      </div>
    </div>
  </section>

  <script>
    const flow = document.getElementById('flow');
    const waveBox = document.getElementById('wave-box');
    const waveText = document.getElementById('wave-text');
    const stage = document.getElementById('flow-stage');
    const nodeEls = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'));
    const sends = Array.from(document.querySelectorAll<SVGPathElement>('.send-line'));

    const SENTENCE = 'yes see you at eight';
    const SEGMENTS = ['yes see you', 'at eight'];
    const STAGES = ['Listening…', 'Transcribing…', 'Cleaning up…', 'Done — text inserted'];
    let flowTimer = 0;
    let flowGen = 0;

    function resetFlow() {
      nodeEls.forEach((n) => n.classList.remove('active'));
      sends.forEach((s) => s.classList.remove('active'));
      if (waveText) waveText.textContent = '';
      if (stage) stage.textContent = 'Idle';
    }

    async function runFlow(gen: number) {
      const wait = (ms: number) => new Promise<boolean>((r) => setTimeout(() => r(gen === flowGen), ms));
      while (gen === flowGen) {
        resetFlow();

        // 1. Speak: words build up in the waveform bubble.
        nodeEls[0]?.classList.add('active');
        if (stage) stage.textContent = STAGES[0];
        if (waveBox) waveBox.classList.add('live');
        for (const segment of SEGMENTS) {
          if (gen !== flowGen) return;
          if (waveText) waveText.textContent = segment;
          if (!(await wait(1500))) return;
        }
        if (waveBox) waveBox.classList.remove('live');

        // 2. Transcribe locally, on the phone.
        nodeEls[0]?.classList.remove('active');
        nodeEls[1]?.classList.add('active');
        if (stage) stage.textContent = STAGES[1];
        if (!(await wait(2000))) return;

        // 3. Clean up locally.
        nodeEls[1]?.classList.remove('active');
        nodeEls[2]?.classList.add('active');
        if (stage) stage.textContent = STAGES[2];
        if (!(await wait(2000))) return;

        // 4. Insert into the field.
        nodeEls[2]?.classList.remove('active');
        nodeEls[3]?.classList.add('active');
        if (stage) stage.textContent = STAGES[3];
        if (!(await wait(2200))) return;
      }
    }

    function startFlow() {
      flow?.classList.add('running');
      const gen = ++flowGen;
      window.clearInterval(flowTimer);
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        nodeEls.forEach((n) => n.classList.add('active'));
        sends.forEach((s) => s.classList.add('active'));
        if (waveText) waveText.textContent = SENTENCE;
        if (stage) stage.textContent = STAGES[3];
        return;
      }
      runFlow(gen);
    }

    function stopFlow() {
      flowGen++;
      window.clearInterval(flowTimer);
      flow?.classList.remove('running');
      resetFlow();
    }

    startFlow();
    const flowSection = document.getElementById('flow-section');
    if (flowSection) {
      new IntersectionObserver(
        (entries) => entries.forEach((e) => (e.isIntersecting ? startFlow() : stopFlow())),
        { threshold: 0.25 },
      ).observe(flowSection);
    }
  </script>

  <script>
    const bubble = document.getElementById('bubble');
    const wrap = document.getElementById('bubble-wrap');
    const feedback = document.getElementById('feedback');
    const fieldText = document.getElementById('field-text');
    const transcript = document.getElementById('transcript');
    const sentMsg = document.getElementById('sent-msg');

    const ringEl = document.querySelector('.bubble-ring .progress');
    const ring = ringEl instanceof SVGCircleElement ? ringEl : null;

    const C = 2 * Math.PI * 26;
    const RAW = 'ehm yes see you at eight';
    const CLEANED =
      '<span class="fix">Y</span>es<span class="fix">,</span> see you at eight<span class="fix">!</span>';
    let generation = 0;

    if (ring) {
      ring.style.strokeDasharray = String(C);
      ring.style.strokeDashoffset = String(C);
    }

    const wait = (ms: number, gen: number) =>
      new Promise<boolean>((resolve) => setTimeout(() => resolve(gen === generation), ms));

    function setFeedback(text: string) {
      if (!feedback) return;
      feedback.textContent = text;
      feedback.hidden = false;
    }

    async function typeRaw(gen: number, duration: number) {
      if (!transcript) return;
      transcript.textContent = '';
      const step = Math.max(30, duration / RAW.length);
      for (let i = 1; i <= RAW.length; i++) {
        if (gen !== generation) return;
        transcript.textContent = RAW.slice(0, i);
        await wait(step, gen);
      }
    }

    async function run(gen: number) {
      if (!bubble || !wrap || !fieldText) return;
      bubble.className = 'bubble';
      wrap.className = 'bubble-wrap';
      fieldText.textContent = '';
      if (transcript) transcript.hidden = true;
      if (sentMsg) sentMsg.hidden = true;
      if (feedback) feedback.hidden = true;
      if (ring) {
        ring.style.transition = 'none';
        ring.style.strokeDashoffset = String(C);
      }
      if (!(await wait(900, gen))) return;

      // Tap: recording. The ring grows clockwise, like the app's time ring.
      bubble.classList.add('recording');
      wrap.classList.add('live');
      setFeedback('Listening…');
      if (transcript) transcript.hidden = false;
      if (ring) {
        requestAnimationFrame(() => {
          if (!ring) return;
          ring.style.transition = 'stroke-dashoffset 2.8s linear';
          ring.style.strokeDashoffset = '0';
        });
      }
      await typeRaw(gen, 2600);
      if (gen !== generation) return;

      // Stop: post-processing. The filler is struck out in the raw card.
      bubble.classList.remove('recording');
      wrap.classList.remove('live');
      wrap.classList.add('busy');
      if (ring) {
        ring.style.transition = 'none';
        ring.style.strokeDashoffset = String(C);
      }
      setFeedback('Cleaning up…');
      if (transcript) transcript.innerHTML = '<span class="fill">ehm </span>yes see you at eight';
      if (!(await wait(800, gen))) return;
      if (transcript) transcript.hidden = true;
      // The cleaned text — not the raw transcript — lands in the field.
      fieldText.innerHTML = CLEANED;
      if (!(await wait(1000, gen))) return;

      // Done: cleaned text sits in the field.
      wrap.classList.remove('busy');
      setFeedback('Done');
      if (!(await wait(900, gen))) return;

      // Send.
      if (feedback) feedback.hidden = true;
      fieldText.textContent = '';
      if (sentMsg) sentMsg.hidden = false;
      if (!(await wait(2400, gen))) return;
    }

    async function loop() {
      const gen = ++generation;
      while (gen === generation) {
        await run(gen);
        if (gen !== generation) break;
        if (!(await wait(400, gen))) break;
      }
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (fieldText) fieldText.innerHTML = CLEANED;
    } else {
      loop();
    }
  </script>

  <style>
    .hero { overflow: hidden; }
    .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 44px; align-items: center; min-height: 470px; padding-top: 84px; padding-bottom: 0; }
    .hero-copy { text-align: left; }
    .hero-copy .actions { justify-content: flex-start; }
    .hero-visual { position: relative; height: 470px; }
    .hero-visual .phone { position: absolute; top: 0; left: 50%; transform: translateX(-50%); }

    .phone { width: 320px; height: 660px; padding: 9px; border-radius: 42px; background: #10151c; box-shadow: 0 24px 60px rgba(5, 25, 35, .28), inset 0 0 0 2px #2a3340; }
    .screen { position: relative; width: 100%; height: 100%; border-radius: 34px; overflow: hidden; background: #eef2f6; font-family: Inter, system-ui, sans-serif; }
    .statusbar { display: flex; justify-content: space-between; align-items: center; padding: 9px 18px 5px; font-size: 11px; font-weight: 700; color: #051923; }
    .status-icons { display: inline-flex; align-items: center; gap: 3px; }
    .status-icons .dot { width: 4px; height: 4px; border-radius: 50%; background: currentColor; display: inline-block; }

    .app { position: absolute; inset: 26px 0 0; display: flex; flex-direction: column; }
    .app-header { display: flex; align-items: center; gap: 10px; padding: 8px 14px 12px; background: #fff; border-bottom: 1px solid #e2e6eb; }
    .avatar { width: 30px; height: 30px; border-radius: 50%; background: var(--primary); color: #fff; font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .app-name { font-size: 15px; font-weight: 700; color: #051923; }
    .app-dots { margin-left: auto; color: #8a94a2; font-size: 16px; }
    .chat { flex: 1; padding: 14px 14px 8px; display: flex; flex-direction: column; gap: 8px; }
    .msg { max-width: 78%; padding: 9px 13px; border-radius: 16px; font-size: 14px; line-height: 1.35; }
    .msg.in { align-self: flex-start; background: #fff; color: #051923; border-bottom-left-radius: 4px; box-shadow: 0 1px 2px rgba(5,25,35,.06); }
    .msg.out { align-self: flex-end; background: var(--primary); color: #fff; border-bottom-right-radius: 4px; }

    .composer { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: #fff; border-top: 1px solid #e2e6eb; }
    .field { flex: 1; min-height: 38px; display: flex; align-items: center; padding: 0 14px; border-radius: 19px; background: #f2f5f8; font-size: 14px; color: #051923; }
    .field-text { white-space: nowrap; overflow: hidden; }
    .caret { width: 1.5px; height: 17px; margin-left: 1px; background: var(--primary); animation: blink 1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    .send { width: 38px; height: 38px; border: 0; border-radius: 50%; background: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; }

    .keyboard { background: #d7dde4; padding: 7px 5px 12px; display: flex; flex-direction: column; gap: 6px; }
    .key-row { display: flex; gap: 4px; justify-content: center; }
    .key-row span { flex: 1; min-width: 0; height: 40px; border-radius: 5px; background: #fff; color: #051923; font-size: 12px; font-weight: 600; display: flex; align-items: center; justify-content: center; box-shadow: 0 1px 0 rgba(5,25,35,.18); }
    .key-row .wide { flex: 1.4; background: #c3ccd6; font-weight: 700; }
    .key-row .space { flex: 4.5; }

    .field-text .fix { color: #1a7f37; font-weight: 800; animation: fixpop 1s ease; }
    @keyframes fixpop { 0% { background: rgba(26,127,55,.22); } 100% { background: transparent; } }

    .bubble-wrap { position: absolute; top: 50%; right: 8px; width: 56px; height: 56px; transform: translateY(-50%); display: flex; align-items: center; justify-content: center; }
    .bubble-ring { position: absolute; inset: 0; overflow: visible; }
    .spinner { display: none; }
    .bubble-wrap.busy .progress { display: none; }
    .bubble-wrap.busy .spinner { display: block; }
    .bubble-wrap.busy .bubble-ring { animation: spin 1s linear infinite; }
    .bubble { position: relative; width: 44px; height: 44px; border-radius: 50%; background: rgba(5,25,35,.87); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 12px rgba(5,25,35,.35); transition: background .18s ease; }
    .bubble.recording { background: rgba(239,68,68,.87); }
    .bubble.busy { background: rgba(5,25,35,.87); }
    .bubble-wrap.live .bubble::after { content: ""; position: absolute; inset: -10px; border-radius: 50%; background: rgba(239,68,68,.28); animation: pulse 1.4s ease-out infinite; }
    @keyframes pulse { 0% { transform: scale(.7); opacity: .7; } 100% { transform: scale(1.25); opacity: 0; } }
    @keyframes spin { to { transform: rotate(360deg); } }

    .feedback { position: absolute; top: 50%; right: 66px; transform: translateY(-190%); max-width: 190px; padding: 7px 12px; border-radius: 16px; background: rgba(5,25,35,.93); color: #fff; font-size: 12.5px; line-height: 1.3; box-shadow: 0 4px 12px rgba(5,25,35,.28); }
    .transcript { position: absolute; top: 50%; right: 66px; transform: translateY(18%); width: 200px; padding: 9px 13px; border-radius: 14px; background: rgba(5,25,35,.86); color: #fff; font-size: 12.5px; line-height: 1.5; box-shadow: 0 4px 12px rgba(5,25,35,.28); }
    .transcript .fill { color: #ff9b9b; text-decoration: line-through; }

    @media (max-width: 900px) {
      .hero-grid { grid-template-columns: 1fr; gap: 24px; padding-top: 64px; min-height: 0; }
      .hero-copy { text-align: center; padding-bottom: 24px; }
      .hero-copy .actions { justify-content: center; }
      .hero-visual { height: 440px; }
    }
    @media (prefers-reduced-motion: reduce) { .bubble-wrap.live .bubble::after, .bubble-wrap.busy .bubble-ring { animation: none; } }

    /* --- Flow diagram --- */
    .flow { position: relative; max-width: 980px; margin: 0 auto; }
    .flow-main { display: flex; align-items: stretch; justify-content: center; gap: 0; }
    .flow-node { position: relative; flex: 1 1 0; min-width: 0; padding: 22px 18px; border: 1px solid var(--line); border-radius: 14px; background: #fff; text-align: center; transition: border-color .3s ease, box-shadow .3s ease, transform .3s ease; }
    .flow-node.active { border-color: var(--primary); box-shadow: 0 10px 26px rgba(5,130,202,.16); transform: translateY(-4px); }
    .flow-icon { width: 52px; height: 52px; margin: 0 auto 12px; border-radius: 14px; background: var(--primary-soft); color: var(--primary-dark); display: flex; align-items: center; justify-content: center; transition: background .3s ease, color .3s ease; }
    .flow-node.active .flow-icon { background: var(--primary); color: #fff; }
    .flow-node h3 { margin-bottom: 6px; font-size: 16px; }
    .flow-node p { margin: 0; color: var(--muted); font-size: 13.5px; line-height: 1.6; }
    .flow-tag { display: inline-block; padding: 3px 9px; border-radius: 7px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
    .flow-tag.local { background: #E4F1E7; color: #1a7f37; }

    .flow-link { flex: 0 0 72px; display: flex; align-items: center; }
    .flow-link svg { width: 100%; height: 24px; overflow: visible; }
    .flow-link .wire { fill: none; stroke: var(--line); stroke-width: 2; }
    .flow-link .send-line { fill: none; stroke: var(--primary); stroke-width: 2.5; stroke-dasharray: 7 7; stroke-dashoffset: 140; }
    .flow.running .flow-link .send-line { animation: dash 1.1s linear infinite; }
    @keyframes dash { to { stroke-dashoffset: 0; } }

    .wave-bubble { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 34px; margin-top: 12px; padding: 6px 12px; border-radius: 17px; background: var(--soft); }
    .wave-bubble .bars { display: flex; align-items: flex-end; gap: 2px; height: 18px; }
    .wave-bubble .bars i { width: 3px; height: 30%; border-radius: 2px; background: var(--primary); }
    .wave-bubble.live .bars i { animation: eq .8s ease-in-out infinite; }
    .wave-bubble .bars i:nth-child(2) { height: 60%; animation-delay: .1s; }
    .wave-bubble .bars i:nth-child(3) { height: 100%; animation-delay: .2s; }
    .wave-bubble .bars i:nth-child(4) { height: 45%; animation-delay: .3s; }
    .wave-bubble .bars i:nth-child(5) { height: 80%; animation-delay: .4s; }
