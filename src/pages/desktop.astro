---
import Layout from '../layouts/Layout.astro';
import DesktopDemo from '../components/DesktopDemo.astro';

const base = import.meta.env.BASE_URL;

// Linux and Windows use stable asset names, so `releases/latest/download`
// always resolves to the newest build. macOS DMGs include the version in the
// file name, so resolve the latest assets through the GitHub API at build time
// and link straight to them. The deploy workflow rebuilds daily so those URLs
// follow the latest release.
const downloads = 'https://github.com/emavgl/ascuta-desktop/releases/latest/download';
const releases = 'https://github.com/emavgl/ascuta-desktop/releases/latest';
const readme = 'https://github.com/emavgl/ascuta-desktop#troubleshooting';

interface ReleaseAsset {
  name: string;
  browser_download_url: string;
}

let macArm = releases;
let macIntel = releases;
try {
  const headers: Record<string, string> = {
    Accept: 'application/vnd.github+json',
    'User-Agent': 'ascuta-website',
  };
  // Authenticate when the build runs in GitHub Actions to avoid the low
  // unauthenticated API rate limit. The token never reaches the browser.
  const token = (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env?.GITHUB_TOKEN;
  if (token) headers.Authorization = `Bearer ${token}`;

  const response = await fetch('https://api.github.com/repos/emavgl/ascuta-desktop/releases/latest', {
    headers,
    signal: AbortSignal.timeout(8000),
  });
  if (response.ok) {
    const release = await response.json() as { assets?: ReleaseAsset[] };
    macArm = release.assets?.find((asset) => asset.name.endsWith('-macos-arm64.dmg'))?.browser_download_url ?? macArm;
    macIntel = release.assets?.find((asset) => asset.name.endsWith('-macos-x86_64.dmg'))?.browser_download_url ?? macIntel;
  }
} catch {
  // Offline build: the macOS buttons fall back to the release page.
}

const linuxInstall = `curl -fsSL ${downloads}/install.sh | bash`;
const windowsSetup = `${downloads}/ascuta-desktop-windows-x86_64-setup.exe`;
---

<Layout
  title="Ascuta Desktop – Offline dictation for Linux, Windows and macOS"
  description="Install Ascuta Desktop on Windows, Linux or macOS. Hold a shortcut, speak, and your words are typed into the app you are using. Audio is processed on your computer."
>
  <section class="page-header"><div class="container">
    <div class="desktop-hero">
      <div class="desktop-hero-copy">
        <p class="eyebrow">Ascuta Desktop</p>
        <h1>Dictate into any app on your computer.</h1>
        <p class="lede">Hold the shortcut (Ctrl+Win, or Option+Space on macOS), speak, release. Your words are typed into the app you were using. Speech is processed on your computer, not uploaded.</p>
        <div class="actions">
          <a class="button button-primary" href={windowsSetup} data-hero-primary>Download for Windows</a>
          <a class="button button-secondary" href="#download" data-hero-secondary>Other platforms</a>
        </div>
        <p class="hero-platforms">Windows, Linux and macOS. No account required.</p>
      </div>
      <DesktopDemo />
    </div>
  </div></section>

  <section class="section" id="download"><div class="container">
    <div class="section-heading">
      <p class="eyebrow">Install</p>
      <h2>Choose your system.</h2>
      <p>Windows 10/11, Linux and macOS 12+. On Windows, you do not need an administrator password.</p>
    </div>

    <div class="platform-grid">
      <article class="platform-card" id="windows">
        <div class="platform-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M3 4.6l7.4-1v7.8H3V4.6zm0 14.8l7.4 1v-7.7H3v6.7zM11.6 3.4L21 2v9.4h-9.4V3.4zm0 17.2L21 22v-9.3h-9.4v7.9z"/></svg>
        </div>
        <h3>Windows 10/11</h3>
        <p>Installs for your account.</p>
        <a class="button button-primary" href={windowsSetup}>Download for Windows</a>
        <p class="small-note">Windows may show a warning. Click <em>More info</em> → <em>Run anyway</em>.</p>
      </article>

      <article class="platform-card" id="macos" data-mac-arm={macArm} data-mac-intel={macIntel}>
        <div class="platform-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M16.4 12.9c0-2.4 2-3.6 2.1-3.7-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.6.9-.8 0-1.9-.9-3.1-.8-1.6 0-3.1.9-3.9 2.4-1.7 2.9-.4 7.2 1.2 9.6.8 1.1 1.7 2.4 3 2.4 1.2 0 1.6-.8 3.1-.8 1.4 0 1.8.8 3.1.8 1.3 0 2.1-1.2 2.9-2.4.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.6-1-2.6-3.8zM14 5.6c.7-.8 1.1-1.9 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4z"/></svg>
        </div>
        <h3>macOS 12+</h3>
        <p>Open the downloaded file and drag <strong>Ascuta</strong> to <em>Applications</em>. On first launch, right-click the app and choose <em>Open</em>.</p>
        <a class="button button-primary" href={macArm} data-mac-download>Download for macOS</a>
        <p class="small-note"><span data-mac-hint>For Apple silicon (M1 or newer).</span> <a href={macIntel} data-mac-alt>Intel Mac? Download the Intel version</a>. Allow Microphone, Accessibility and Input Monitoring when macOS asks.</p>
      </article>

      <article class="platform-card" id="linux">
        <div class="platform-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c-1.9 0-3.2 1.5-3.2 3.6 0 1.4.2 2.4-.4 3.6-.5 1-1.4 1.9-1.9 3.1-.5 1.1-.4 2.2.2 2.9.3.4.3.8.2 1.3-.2.7.1 1.5.8 1.8.6.3 1.3.2 1.8-.2.6-.4 1.4-.4 2.5-.4s1.9 0 2.5.4c.5.4 1.2.5 1.8.2.7-.3 1-1.1.8-1.8-.1-.5-.1-.9.2-1.3.6-.7.7-1.8.2-2.9-.5-1.2-1.4-2.1-1.9-3.1-.6-1.2-.4-2.2-.4-3.6C15.2 3.5 13.9 2 12 2zm-1.4 4.1a.8.8 0 110 1.6.8.8 0 010-1.6zm2.8 0a.8.8 0 110 1.6.8.8 0 010-1.6zM9.6 9.7c.3.5 1.3.9 2.4.9s2.1-.4 2.4-.9c.2-.3.5-.1.4.2-.3.9-1.4 1.5-2.8 1.5s-2.5-.6-2.8-1.5c-.1-.3.2-.5.4-.2zM8 19.4c-1.1 0-2 .5-2 1.2s.9 1.2 2 1.2h8c1.1 0 2-.5 2-1.2s-.9-1.2-2-1.2H8z"/></svg>
        </div>
        <h3>Linux (64-bit)</h3>
        <p>Adds Ascuta to your applications menu.</p>
        <div class="terminal">
          <div class="terminal-bar"><span></span><span></span><span></span><button class="terminal-copy" type="button" data-copy aria-label="Copy Linux install command">Copy</button></div>
          <pre><code data-copy-source>{linuxInstall}</code></pre>
        </div>
        <p class="small-note">Paste the command into a terminal. If asked for permission to read your keyboard, accept it and log out and back in.</p>
      </article>
    </div>

    <p class="platform-footnote">Need a different version? See the <a href={releases}>downloads page</a>.</p>
  </div></section>

  <section class="section section-soft" id="after-install"><div class="container after-grid">
    <div class="after-panel">
      <p class="eyebrow">First run</p>
      <h2>Set up once.</h2>
      <ol class="mini-steps">
        <li>Open Ascuta and download a speech model: Parakeet v2 for English (~640 MB), Parakeet v3 for 25 European languages (~670 MB), or Whisper for other languages.</li>
        <li>Choose the shortcut and language, then close the window.</li>
        <li>Click into a text box, hold the shortcut, speak and release.</li>
      </ol>
    </div>
    <div class="after-panel">
      <p class="eyebrow">Optional</p>
      <h2>Use your phone as the microphone.</h2>
      <p>Open Ascuta's settings, turn on <strong>Send from phone</strong>, then scan the QR code from Ascuta on Android (<strong>Home → Send to computer</strong>). If no QR code appears, restart Ascuta. Both devices must be on the same Wi-Fi; if they do not connect, allow Ascuta through your firewall.</p>
    </div>
  </div></section>

  <section class="page-note-section"><div class="container">
    <p class="page-note">Need help? See the <a href={readme}>troubleshooting notes</a>. Ascuta is also available for <a href={base}>Android</a>.</p>
  </div></section>
</Layout>

<style>
  .desktop-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .desktop-hero-copy .actions { justify-content: flex-start; }
  .desktop-hero-copy .lede { margin: 0; }
  .desktop-hero-copy h1 { font-size: clamp(40px, 5.6vw, 58px); }
  .hero-platforms { margin: 18px 0 0; color: var(--muted); font-size: 14px; }

  .platform-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; align-items: start; }
  .platform-card { position: relative; min-width: 0; padding: 28px; border: 1px solid var(--line); border-radius: 16px; background: #fff; }
  .platform-card.is-current { border-color: var(--primary); box-shadow: 0 8px 24px rgba(5, 130, 202, .08); }
  .platform-badge { position: absolute; top: 16px; right: 16px; padding: 3px 9px; border-radius: 999px; background: var(--primary-soft); color: var(--primary-dark); font-size: 11px; font-weight: 700; }
  .platform-card h3 { margin: 14px 0 10px; font-size: 20px; letter-spacing: -.02em; }
  .platform-card > p { color: var(--muted); font-size: 14px; line-height: 1.65; }
  .platform-card .button { width: 100%; margin-top: 6px; }
  .platform-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; color: var(--primary-dark); background: var(--primary-soft); }
  .platform-card .small-note a { color: var(--primary-dark); font-weight: 600; }
  .platform-footnote { margin: 34px 0 0; color: var(--muted); font-size: 14px; text-align: center; }
  .platform-footnote a { color: var(--primary-dark); font-weight: 600; }

  .terminal { min-width: 0; margin: 18px 0 14px; border: 1px solid #23303a; border-radius: 12px; overflow: hidden; background: #0b1720; }
  .terminal-bar { display: flex; align-items: center; gap: 7px; padding: 9px 12px; background: #13232e; }
  .terminal-bar > span { width: 9px; height: 9px; border-radius: 50%; background: #39505f; }
  .terminal-copy { margin-left: auto; padding: 6px 12px; border: 1px solid #3a5160; border-radius: 6px; color: #d7e6ef; background: transparent; font: inherit; font-size: 11px; font-weight: 600; cursor: pointer; }
  .terminal-copy:hover { background: #1d3341; }
  .terminal pre { margin: 0; padding: 15px; overflow-x: auto; }
  .terminal code { padding: 0; background: none; color: #e6f2f9; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12.5px; line-height: 1.6; white-space: pre; }

  .after-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .after-panel h2 { margin-bottom: 14px; font-size: clamp(28px, 4vw, 36px); letter-spacing: -.04em; }
  .after-panel p, .after-panel li { color: var(--muted); font-size: 15px; line-height: 1.7; }
  .mini-steps { margin: 0; padding-left: 20px; }
  .mini-steps li { margin: 10px 0; }

  .page-note-section { padding: 40px 0 72px; }
  .page-note { margin: 0; color: var(--muted); font-size: 14px; text-align: center; }
  .page-note a { color: var(--primary-dark); font-weight: 600; }

  @media (max-width: 900px) {
    .desktop-hero { grid-template-columns: 1fr; gap: 20px; }
    .desktop-hero-copy { text-align: center; }
    .desktop-hero-copy .actions { justify-content: center; }
    .desktop-hero-copy .lede { margin: 0 auto; }
    .platform-grid { grid-template-columns: minmax(0, 1fr); }
    .after-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
  }

  @media (max-width: 520px) {
    .platform-card { padding: 22px; }
  }
</style>

<script>
  const playStore = 'https://play.google.com/store/apps/details?id=eu.viglianisi.ascuta';
  const ua = navigator.userAgent;
  const nav = navigator as any;
  const platform = nav.userAgentData?.platform || nav.platform || '';
  const isAndroid = /Android/i.test(ua);
  const isIOS = /iPhone|iPad|iPod/i.test(ua) || (platform === 'macOS' && navigator.maxTouchPoints > 1);

  let os: 'windows' | 'macos' | 'linux' | 'android' | 'ios' | 'other' = 'other';
  if (isAndroid) os = 'android';
  else if (isIOS) os = 'ios';
  else if (/Win/i.test(platform) || /Windows/i.test(ua)) os = 'windows';
  else if (/Mac/i.test(platform) || /Mac OS X/i.test(ua)) os = 'macos';
  else if (/Linux|X11/i.test(platform) || /Linux/i.test(ua)) os = 'linux';

  const primary = document.querySelector<HTMLAnchorElement>('[data-hero-primary]');
  const secondary = document.querySelector<HTMLAnchorElement>('[data-hero-secondary]');
  const macCard = document.getElementById('macos');
  const macDownload = document.querySelector<HTMLAnchorElement>('[data-mac-download]');
  const macAlt = document.querySelector<HTMLAnchorElement>('[data-mac-alt]');
  const macHint = document.querySelector<HTMLElement>('[data-mac-hint]');

  function setHero(href: string, label: string, altHref = '#download', altLabel = 'Other platforms') {
    if (primary) {
      primary.href = href;
      primary.textContent = label;
    }
    if (secondary) {
      secondary.href = altHref;
      secondary.textContent = altLabel;
    }
  }

  if (os === 'linux') {
    setHero('#linux', 'Install on Linux');
  } else if (os === 'android') {
    setHero(playStore, 'Get Ascuta for Android', '#download', 'Desktop downloads');
  } else if (os === 'ios') {
    setHero('#download', 'See downloads');
    if (secondary) secondary.hidden = true;
  } else if (os === 'other') {
    setHero('#download', 'See downloads', playStore, 'Get Ascuta for Android');
  }

  if (os === 'macos' && macCard && macDownload && macAlt && macHint) {
    const arm = macCard.getAttribute('data-mac-arm') || '#download';
    const intel = macCard.getAttribute('data-mac-intel') || '#download';
    setHero(arm, 'Download for macOS');

    const download = macDownload;
    const alt = macAlt;
    const hint = macHint;
    const uaData = nav.userAgentData;
    if (uaData?.getHighEntropyValues) {
      uaData.getHighEntropyValues(['architecture']).then((values: { architecture?: string }) => {
        if (values.architecture === 'x86') {
          download.href = intel;
          hint.textContent = 'For Intel Macs.';
          alt.href = arm;
          alt.textContent = 'Apple silicon? Download the Apple silicon version';
          if (primary) primary.href = intel;
        }
      }).catch(() => {});
    }
  }

  const grid = document.querySelector('.platform-grid');
  const current = os === 'windows' || os === 'macos' || os === 'linux' ? document.getElementById(os) : null;
  if (grid && current) {
    if (grid.firstElementChild !== current) grid.prepend(current);
    current.classList.add('is-current');
    const badge = document.createElement('span');
    badge.className = 'platform-badge';
    badge.textContent = 'Your system';
    current.append(badge);
  }
</script>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const command = button.closest('.terminal')?.querySelector<HTMLElement>('[data-copy-source]');
    if (!command) return;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command.textContent?.trim() ?? '');
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = 'Copy'; }, 1800);
      } catch {
        button.textContent = 'Select and copy';
      }
    });
  });
</script>
