---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

const planColumns = ['Free', 'Lifetime Pro'];

const planRows = [
  ['Whisper Tiny & Base, English and multilingual', '✓', '✓'],
  ['Floating bubble in any app', '✓', '✓'],
  ['Voice typing keyboard and voice-input popup', '✓', '✓'],
  ['Whisper Small, the most accurate Whisper', '✗', '✓'],
  ['Parakeet voice models', '✗', '✓'],
  ['Gemma voice models', '✗', '✓'],
  ['Live transcription while you speak', '✗', '✓'],
  ['Cloud models with your own key', '✗', '✓'],
  ['AI post-processing with Gemma', '✗', '✓'],
];
---
<Layout title="Pricing – Ascuta" description="Ascuta is free to use, with an optional one-time Lifetime Pro purchase. No subscription, billed securely via Google Play.">
  <section class="page-header"><div class="container"><p class="eyebrow">Pricing</p><h1>Free to use. Pro, once.</h1><p class="lede">Everything you need to dictate stays free forever. One optional purchase unlocks the rest — a single payment, no subscription, no expiry.</p></div></section>

  <section class="section"><div class="container narrow">
    <div class="price-grid">
      <article class="price-card">
        <p class="price-badge">Always free</p>
        <h2>Free</h2>
        <p class="price-sub">Dictate every day, free forever.</p>
        <p class="price-amount" data-free-price>$0, forever</p>
        <p class="price-local">No payment, no account</p>
        <p class="price-list-lead">Includes:</p>
        <ul class="price-list">
          <li><span aria-hidden="true">✓</span> Whisper Tiny &amp; Base, English and multilingual</li>
          <li><span aria-hidden="true">✓</span> Floating bubble in any app</li>
          <li><span aria-hidden="true">✓</span> Voice typing keyboard and voice-input popup</li>
        </ul>
        <a class="button button-secondary" href={`${base}docs`}>Get started</a>
      </article>

      <article class="price-card price-featured">
        <p class="price-badge">One-time · no subscription</p>
        <h2>Lifetime Pro</h2>
        <p class="price-sub">For power dictators and professionals.</p>
        <p class="price-amount" data-price>$5.49</p>
        <p class="price-local">One-time payment, <span data-price-note>shown in USD</span></p>
        <p class="price-list-lead">Everything in Free, plus:</p>
        <ul class="price-list">
          <li><span aria-hidden="true">✓</span> Whisper Small, the most accurate Whisper</li>
          <li><span aria-hidden="true">✓</span> Parakeet and Gemma voice models</li>
          <li><span aria-hidden="true">✓</span> Live transcription while you speak</li>
          <li><span aria-hidden="true">✓</span> Bring-your-own-key cloud models</li>
          <li><span aria-hidden="true">✓</span> AI post-processing with Gemma</li>
        </ul>
        <p class="small-note">Buy once inside the app — the exact price is shown before you confirm.</p>
      </article>
    </div>

    <div class="section-heading"><p class="eyebrow">Compare plans</p><h2>See the full feature table.</h2></div>
    <div class="compare-wrap"><table class="compare-table"><thead><tr><th scope="col"><span class="visually-hidden">Feature</span></th>{planColumns.map((name, i) => <th scope="col" class={i === 1 ? 'compare-us' : undefined}>{name}</th>)}</tr></thead><tbody>{planRows.map(([label, ...cells]) => <tr><th scope="row">{label}</th>{cells.map((cell, i) => <td class={i === 1 ? 'compare-us' : undefined}>{cell}</td>)}</tr>)}</tbody></table></div>

    <article class="support-card billing-box">
      <h3>Billing</h3>
      <ol>
        <li>Lifetime Pro is a single purchase handled entirely by Google Play — Ascuta never sees your payment details.</li>
        <li>No subscription and no expiry: pay once, keep it. Restore is available on the paywall.</li>
        <li>The app stores only an encrypted local flag and re-checks ownership with Play on every start, so reinstalls and refunds are reflected automatically.</li>
        <li>The exact price is shown in the app before you confirm anything.</li>
      </ol>
      <p>See the <a href={`${base}terms`}>Terms &amp; Conditions</a> for purchase, withdrawal, and warranty information.</p>
    </article>
  </div></section>
</Layout>

<style>
  .compare-wrap { margin-bottom: 28px; }
  /* Shared row tracks keep both cards the same height with prices, list
     headings and lists aligned on the same horizontal lines. */
  .price-grid { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto auto auto auto auto 1fr auto; column-gap: 22px; row-gap: 0; margin-bottom: 28px; }
  .price-card { display: grid; grid-row: span 8; grid-template-rows: subgrid; row-gap: 0; padding: 32px; border: 1px solid var(--line); border-radius: 14px; background: #fff; }
  .price-featured { border: 2px solid var(--primary); }
  .price-badge { align-self: start; justify-self: start; margin: 0 0 14px; padding: 5px 12px; border-radius: 999px; background: var(--primary-soft); color: var(--primary-on-soft); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .price-card h2 { margin-bottom: 6px; color: var(--ink); font-size: 24px; }
  .price-sub { margin-bottom: 14px; color: var(--muted); font-size: 15px; }
  .price-amount { margin-bottom: 6px; color: var(--ink); font-size: 30px; font-weight: 800; letter-spacing: -.03em; }
  .price-local { margin-bottom: 14px; color: var(--muted); font-size: 14px; }
  .price-list-lead { margin: 0 0 12px; color: var(--ink); font-size: 15px; font-weight: 700; }
  .price-list { list-style: none; margin: 0 0 26px; padding: 0; }
  .price-list li { display: flex; gap: 10px; margin: 10px 0; color: var(--muted); font-size: 15px; line-height: 1.6; }
  .price-list span { color: var(--primary); font-weight: 700; }
  .price-card .button { align-self: stretch; text-align: center; }
  .price-card .small-note { align-self: center; margin: 0; }
  .billing-box ol { padding-left: 22px; }
  @media (max-width: 700px) {
    .price-grid { grid-template-columns: 1fr; grid-template-rows: none; }
    .price-card { grid-row: auto; grid-template-rows: none; display: flex; flex-direction: column; }
    .price-list { flex: 1; }
  }
</style>

<script>
  // Prices come from Google Play (public/prices.json, regenerated with
  // `npm run prices`). We show the visitor's regional price when we can
  // determine their country and it exists in the Play price list, otherwise
  // we fall back to USD.
  const GEO_ENDPOINT = 'https://api.country.is/';
  const TIMEOUT_MS = 5000;

  interface PriceEntry {
    currency: string;
    amount: number;
  }

  interface Prices {
    fallback: PriceEntry;
    regions?: Record<string, PriceEntry>;
  }

  function formatPrice(entry: PriceEntry) {
    try {
      return new Intl.NumberFormat(navigator.language || undefined, {
        style: 'currency',
        currency: entry.currency,
        currencyDisplay: 'symbol',
      }).format(entry.amount);
    } catch {
      return `${entry.currency} ${entry.amount}`;
    }
  }

  function countryFromLocale() {
    for (const tag of navigator.languages || [navigator.language]) {
      if (!tag) continue;
      try {
        const region = new Intl.Locale(tag).region;
        if (region) return region;
      } catch {}
      const match = /[-_]([A-Za-z]{2})$/.exec(tag);
      if (match) return match[1].toUpperCase();
    }
    return null;
  }

  async function detectCountry() {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
    try {
      const response = await fetch(GEO_ENDPOINT, { signal: controller.signal });
      if (response.ok) {
        const data = await response.json();
        if (data && data.country) return String(data.country).toUpperCase();
      }
    } catch {
    } finally {
      clearTimeout(timer);
    }
    return countryFromLocale();
  }

  async function applyPrices() {
    if (!document.querySelector('[data-price]')) return;

    let prices: Prices;
    try {
      const response = await fetch(`${import.meta.env.BASE_URL}prices.json`, { cache: 'no-cache' });
      if (!response.ok) throw new Error(String(response.status));
      prices = await response.json();
    } catch {
      return;
    }

    const country = await detectCountry();
    const regional = country && prices.regions ? prices.regions[country] : null;
    const entry = regional || prices.fallback;
    if (!entry) return;

    const amount = formatPrice(entry);
    const note = regional
      ? `shown in ${entry.currency}`
      : `shown in ${entry.currency}, local price unavailable`;

    document.querySelectorAll('[data-price]').forEach((el) => {
      el.textContent = amount;
    });
    document.querySelectorAll('[data-price-note]').forEach((el) => {
      el.textContent = note;
    });

    const free = entry.currency === 'EUR' ? '€0, forever' : '$0, forever';
    document.querySelectorAll('[data-free-price]').forEach((el) => {
      el.textContent = free;
    });
  }

  applyPrices();
</script>
