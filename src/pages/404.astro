---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Page Not Found – VoiceFlow" description="The requested VoiceFlow page does not exist.">
  <section class="page-header"><div class="container"><p class="eyebrow">404</p><h1>Page not found.</h1><p class="lede">The page does not exist. Return to VoiceFlow home.</p><p><a class="button button-primary" href={base}>Back to home</a></p></div></section>
</Layout>
