---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const features = [
  ['🎙️', 'Dictate across apps', 'Use the floating bubble, voice-input panel, or Ascuta keyboard wherever Android exposes a text field.'],
  ['◎', 'On-device first', 'Download a local model once and keep audio on your phone. No account is required.'],
  ['✦', 'On-device AI post-processing', 'Polish grammar, fix wording, or translate locally — or with a cloud provider you choose.'],
  ['⌨', 'Keep your keyboard', 'Ascuta complements your existing keyboard instead of forcing you to replace it.']
];

const faqs = [
  ['Does local mode upload audio?', 'No. With a local engine, speech is processed on the device. Network access is used for model downloads and other operations you explicitly configure.', null],
  ['Which model should I download?', 'For most people, Whisper Base: small download, 99 languages, solid accuracy. Pick Parakeet for fast European-language dictation or Nemotron for live words while you speak.', ['docs#models-voice', 'Models & hardware']],
  ['Why does the bubble need Accessibility permission?', 'Android only lets an app insert text into another app’s focused field through Accessibility Service. Ascuta uses it for that insertion after you tap the bubble.', ['docs#bubble', 'Floating bubble']],
  ['Can I use Ascuta without the bubble?', 'Yes. Use the voice-input popup or select Ascuta as an on-screen voice typing keyboard.', ['docs#ascuta-keyboard', 'Ascuta Keyboard']],
  ['What does post-processing do?', 'It can clean up grammar and punctuation, summarize the transcript, apply spoken formatting commands, or follow your own custom prompt.', ['docs#postprocessing-actions', 'Post-processing actions']],
  ['What if an app does not accept inserted text?', 'Ascuta falls back to copying the transcript to the clipboard so it can be pasted manually.', ['docs#troubleshooting', 'Troubleshooting']],
];

const comparisonColumns = ['Ascuta', 'FUTO Voice Input', 'Wispr Flow'];

const comparisonRows = [
  ['Price for full features', 'One-time Pro', 'One-time license', '$15/month'],
  ['Works fully offline', '✓', '✓', '✗'],
  ['Account required', 'None', 'None', 'Yes'],
  ['Floating bubble in any app', '✓', '✗', '✗'],
  ['Keep your current keyboard', '✓', '✓', '✓'],
  ['Speech engines to choose from', '5', '1', '1'],
  ['On-device AI post-processing', '✓', '✗', 'Cloud only'],
];
---

<Layout title="Ascuta – Private voice typing for Android" description="Ascuta is private, practical voice typing for Android with local and optional cloud transcription.">
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Private voice typing for Android</p>
      <h1>Turn your voice into <span class="hero-accent">words that stay yours.</span></h1>
      <p class="lede">Ascuta puts dictation into the text field you are already using. Tap the bubble, speak naturally, and keep moving.</p>
      <div class="actions"><a class="button button-primary" href={`${base}#features`}>Explore Ascuta</a><a class="button button-secondary" href={`${base}docs`}>Read the docs</a></div>
    </div>
  </section>

  <section id="features" class="section"><div class="container"><div class="section-heading"><p class="eyebrow">Built around the useful part</p><h2>Say less to your phone. Tap less, too.</h2><p>Ascuta is a small, direct tool for getting speech into the app where you need it — and your words can stay on your phone while it works.</p></div><div class="feature-grid">{features.map(([icon, title, description]) => <article class="feature-card"><div class="feature-icon" aria-hidden="true">{icon}</div><h3>{title}</h3><p>{description}</p></article>)}</div><div class="mode-list modes-after-grid"><div class="mode"><span class="mode-icon">◎</span><div><h3>On-device transcription</h3><p>Whisper, Parakeet, Gemma, Nemotron, or the system engine can process speech locally. Downloaded models run without sending audio away.</p></div></div><div class="mode"><span class="mode-icon">↗</span><div><h3>Optional cloud transcription</h3><p>Use an OpenAI-compatible provider with your own key. Requests go directly from your phone to that provider.</p></div></div><div class="mode"><span class="mode-icon">✦</span><div><h3>Optional post-processing</h3><p>Clean up grammar, summarize, or translate using an available on-device or cloud model.</p></div></div></div></div></section>

  <section id="compare" class="section"><div class="container"><div class="section-heading"><p class="eyebrow">Why Ascuta</p><h2>Offline like FUTO. Polished like Wispr. No subscription like neither.</h2><p>What the best-known alternatives cost you — in money, privacy, or flexibility.</p></div><div class="compare-wrap"><table class="compare-table"><thead><tr><th scope="col"><span class="visually-hidden">Feature</span></th>{comparisonColumns.map((name, i) => <th scope="col" class={i === 0 ? 'compare-us' : undefined}>{name}</th>)}</tr></thead><tbody>{comparisonRows.map(([label, ...cells]) => <tr><th scope="row">{label}</th>{cells.map((cell, i) => <td class={i === 0 ? 'compare-us' : undefined}>{cell}</td>)}</tr>)}</tbody></table></div><p class="small-note">Prices and features checked September 2026.</p></div></section>

  <section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">Questions, answered</p><h2>Start simple.</h2><p>The important details before you grant permissions or download a model.</p></div><div class="support-grid">{faqs.map(([question, answer, link]) => <details class="support-card"><summary><h2>{question}</h2><span>+</span></summary><p>{answer}{link && <> <a href={`${base}${link[0]}`}>{link[1]} →</a></>}</p></details>)}</div></div></section>

  <section class="cta"><div class="container cta-inner"><div><p class="eyebrow">Need help?</p><h2>Setup should take minutes.</h2><p>Use the docs for permissions, models, and common insertion problems.</p></div><a class="button button-secondary" href={`${base}docs`}>Open docs</a></div></section>
</Layout>

<style>
  .support-card summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 15px; cursor: pointer; }
  .support-card summary::-webkit-details-marker { display: none; }
  .support-card summary h2 { margin: 0; font-size: 18px; }
  .support-card summary span { color: var(--primary); font-size: 23px; }
  .support-card[open] summary span { transform: rotate(45deg); }
  .support-card p { margin-top: 16px; }
</style>
