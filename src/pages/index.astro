---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const features = [
  ['mic', 'Dictate across apps', 'The floating bubble, voice-input panel, or Ascuta keyboard put words into the text field you are already using.'],
  ['phone', 'On-device first', 'Download a Whisper, Parakeet, Nemotron, or Gemma model once. Audio never leaves your phone, and no account is required.'],
  ['signal', 'Live words while you speak', 'Streaming engines show the transcript as you talk, then land the final text when you stop.'],
  ['sparkles', 'On-device AI post-processing', 'Clean up grammar, summarize, or translate locally — or with a cloud provider you choose.'],
  ['cpu', 'Agent mode', 'Dictate instructions instead of words: Ascuta carries them out and inserts the result.'],
  ['cloud', 'Optional cloud transcription', 'Use an OpenAI-compatible provider with your own key. Requests go straight from your phone to that provider.'],
  ['keyboard', 'Keep your keyboard', 'Ascuta complements the keyboard you already use instead of forcing you to replace it.'],
  ['globe', 'Up to 99 languages', 'Several multilingual models are supported — Whisper covers up to 99 languages with auto-detect.']
];

const icons = {
  mic: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z"/></svg>',
  phone: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"/></svg>',
  signal: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.348 14.651a3.75 3.75 0 010-5.303m5.304 0a3.75 3.75 0 010 5.303m-7.425 2.122a6.75 6.75 0 010-9.546m9.546 0a6.75 6.75 0 010 9.546M5.106 18.894c-3.808-3.808-3.808-9.98 0-13.789m13.788 0c3.808 3.808 3.808 9.981 0 13.79M12 12h.008v.008H12V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>',
  sparkles: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"/></svg>',
  cloud: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z"/></svg>',
  keyboard: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/><path stroke-linecap="round" d="M7 11h.01M11 11h.01M15 11h.01M17.5 11h.01M7 14.5h10"/></svg>',
  cpu: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z"/></svg>',
  globe: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5a11.964 11.964 0 01-10.07-5.454M12 10.5a11.964 11.964 0 0010.07-5.454"/></svg>',
};

const faqs = [
  ['Does local mode upload audio?', 'No. With a local engine, speech is processed on the device. Network access is used for model downloads and other operations you explicitly configure.', null],
  ['Which model should I download?', 'For most people, Whisper Base: small download, up to 99 languages, solid accuracy. Pick Parakeet for fast European-language dictation or Nemotron for live words while you speak.', ['docs#models-voice', 'Models & hardware']],
  ['Which languages can I dictate in?', 'Whisper covers up to 99 languages; Parakeet v3 covers 25 European languages; Nemotron covers 32 locales; the system engine follows your Language setting.', ['docs#languages', 'Supported languages']],
  ['Why does the bubble need Accessibility permission?', 'Android only lets an app insert text into another app’s focused field through Accessibility Service. Ascuta uses it for that insertion after you tap the bubble.', ['docs#bubble', 'Floating bubble']],
  ['Can I use Ascuta without the bubble?', 'Yes. Use the voice-input popup or select Ascuta as an on-screen voice typing keyboard.', ['docs#ascuta-keyboard', 'Ascuta Keyboard']],
  ['What does post-processing do?', 'It can clean up grammar and punctuation, summarize the transcript, apply spoken formatting commands, or follow your own custom prompt.', ['docs#postprocessing-actions', 'Post-processing actions']],
  ['What is Agent mode?', 'Instead of dictating words, dictate an instruction — Ascuta carries it out and inserts the result.', ['docs#agent-mode', 'Agent mode']],
  ['What if an app does not accept inserted text?', 'Ascuta falls back to copying the transcript to the clipboard so it can be pasted manually.', ['docs#troubleshooting', 'Troubleshooting']],
];

const comparisonColumns = ['Ascuta', 'FUTO Voice Input', 'Wispr Flow'];

const comparisonRows = [
  ['Pricing model', null, 'Free + one-time Pro', 'Free*', 'Free + subscription'],
  ['Works fully offline', 'free', '✓', '✓', '✗'],
  ['Account required', null, 'None', 'None', 'Yes'],
  ['Floating bubble in any app', 'free', '✓', '✗', '✗'],
  ['Keep your current keyboard', 'free', '✓', '✓', '✓'],
  ['Speech engines to choose from', 'pro', '5', '1', '1'],
  ['On-device AI post-processing', 'pro', '✓', '✗', 'Cloud only'],
  ['Agent mode: dictate instructions', 'pro', '✓', '✗', 'Desktop only'],
];
---

<Layout title="Ascuta – Private voice typing for Android" description="Ascuta is private, practical voice typing for Android with local and optional cloud transcription.">
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Private voice typing for Android</p>
      <h1>Turn your voice into <span class="hero-accent">words that stay yours.</span></h1>
      <p class="lede">Ascuta puts dictation into the text field you are already using. Tap the bubble, speak naturally, and keep moving.</p>
      <div class="actions"><a class="button button-primary" href={`${base}#features`}>Explore Ascuta</a><a class="button button-secondary" href={`${base}docs`}>Read the docs</a></div>
    </div>
  </section>

  <section id="features" class="section"><div class="container"><div class="section-heading"><p class="eyebrow">Built around the useful part</p><h2>Say less to your phone. Tap less, too.</h2><p>Ascuta is a small, direct tool for getting speech into the app where you need it — and your words can stay on your phone while it works.</p></div><div class="feature-grid">{features.map(([icon, title, description]) => <article class="feature-card"><div class="feature-icon" aria-hidden="true"><Fragment set:html={icons[icon]} /></div><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>

  <section id="compare" class="section"><div class="container"><div class="section-heading"><p class="eyebrow">Why Ascuta</p><h2>How Ascuta compares.</h2><p>In the Ascuta column, <span class="mark-free">green</span> is included free and <span class="mark-pro">blue</span> is Lifetime Pro — so you can see how far the free app already goes.</p></div><div class="compare-wrap"><table class="compare-table"><thead><tr><th scope="col"><span class="visually-hidden">Feature</span></th>{comparisonColumns.map((name, i) => <th scope="col" class={i === 0 ? 'compare-us' : undefined}>{name}</th>)}</tr></thead><tbody>{comparisonRows.map(([label, tier, ...cells]) => <tr><th scope="row">{label}</th>{cells.map((cell, i) => <td class={i === 0 ? 'compare-us' : undefined}>{i === 0 && tier ? <span class={tier === 'free' ? 'mark-free' : 'mark-pro'}>{cell}</span> : cell}</td>)}</tr>)}</tbody></table></div><p class="small-note">* FUTO offers an optional one-time payment to support development. Prices and features checked September 2026. <a href={`${base}pricing`}>See Pricing</a> for what Free and Lifetime Pro include.</p></div></section>

  <section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">Questions, answered</p><h2>Start simple.</h2><p>The important details before you grant permissions or download a model.</p></div><div class="support-grid">{faqs.map(([question, answer, link]) => <details class="support-card"><summary><h2>{question}</h2><span>+</span></summary><p>{answer}{link && <> <a href={`${base}${link[0]}`}>{link[1]} →</a></>}</p></details>)}</div></div></section>

  <section class="cta"><div class="container cta-inner"><div><p class="eyebrow">Need help?</p><h2>Setup should take minutes.</h2><p>Use the docs for permissions, models, and common insertion problems.</p></div><a class="button button-secondary" href={`${base}docs`}>Open docs</a></div></section>
</Layout>

<style>
  .support-card summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 15px; cursor: pointer; }
  .support-card summary::-webkit-details-marker { display: none; }
  .support-card summary h2 { margin: 0; font-size: 18px; }
  .support-card summary span { color: var(--primary); font-size: 23px; }
  .support-card[open] summary span { transform: rotate(45deg); }
  .support-card p { margin-top: 16px; }
</style>
