---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Redeem a promo code – Ascuta"
  description="Redeem a one-time Google Play promo code for Ascuta Lifetime Pro."
  noindex
>
  <section class="page-header"><div class="container"><p class="eyebrow">Promo code</p><h1>Redeem your Ascuta Pro code.</h1><p class="lede">Claim a one-time Google Play promo code for Lifetime Pro. One code per person.</p></div></section>
  <section class="section"><div class="container narrow">
    <div class="support-card redeem-card">
      <p id="intro">Tap the button to get your code. You redeem it through Google Play, so Lifetime Pro is tied to your Google account — no Ascuta account needed.</p>
      <button class="button button-primary" id="claim-btn" type="button">Get my promo code</button>
      <div class="redeem-result" id="result" hidden>
        <p>Your promo code</p>
        <div class="redeem-code"><code id="code-value"></code><button class="button button-secondary" id="copy-btn" type="button">Copy</button></div>
        <p class="redeem-note" id="already" hidden>You already claimed a code from this connection, so this is your original one.</p>
        <p>To redeem it, open the Google Play Store app, open the menu, choose <strong>Redeem code</strong>, and paste the code. Then open Ascuta — Lifetime Pro will be active.</p>
        <a class="button button-primary redeem-play" href="https://play.google.com/redeem" target="_blank" rel="noopener">Open Google Play</a>
        <button class="button button-secondary redeem-more" id="more-btn" type="button" hidden>Get another code</button>
      </div>
      <p class="redeem-error" id="error" hidden></p>
    </div>
  </div></section>

  <script>
    const API = 'https://ascuta.viglianisi.ovh/api/redeem';
    const claimBtn = document.getElementById('claim-btn') as HTMLButtonElement | null;
    const moreBtn = document.getElementById('more-btn') as HTMLButtonElement | null;
    const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement | null;
    const result = document.getElementById('result');
    const codeValue = document.getElementById('code-value');
    const already = document.getElementById('already');
    const error = document.getElementById('error');
    const intro = document.getElementById('intro');

    function showError(message: string) {
      if (!error) return;
      error.textContent = message;
      error.hidden = false;
    }

    async function claim(button: HTMLButtonElement | null, label: string) {
      if (button) {
        button.disabled = true;
        button.textContent = 'Getting your code…';
      }
      if (error) error.hidden = true;
      try {
        const response = await fetch(API, { method: 'POST' });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          showError(
            response.status === 404
              ? 'All promo codes have been claimed. Thanks for the interest!'
              : response.status === 429
                ? 'Too many attempts. Please wait a minute and try again.'
                : 'Something went wrong. Please try again in a moment.',
          );
          if (button) {
            button.disabled = false;
            button.textContent = 'Try again';
          }
          return;
        }
        if (codeValue) codeValue.textContent = data.code;
        if (already) already.hidden = !data.alreadyClaimed;
        if (result) result.hidden = false;
        if (intro) intro.hidden = true;
        if (claimBtn) claimBtn.hidden = true;
        // Trusted networks (LAN / Tailscale) can mint more than one code.
        if (moreBtn) moreBtn.hidden = !data.trusted;
        if (button) {
          button.disabled = false;
          button.textContent = label;
        }
      } catch {
        showError('Cannot reach the server right now. Please try again in a moment.');
        if (button) {
          button.disabled = false;
          button.textContent = 'Try again';
        }
      }
    }

    claimBtn?.addEventListener('click', () => claim(claimBtn, 'Get my promo code'));
    moreBtn?.addEventListener('click', () => claim(moreBtn, 'Get another code'));

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(codeValue?.textContent ?? '');
        copyBtn.textContent = 'Copied';
        setTimeout(() => (copyBtn.textContent = 'Copy'), 2000);
      } catch {
        copyBtn.textContent = 'Select & copy';
      }
    });
  </script>

  <style>
    .redeem-card { max-width: 640px; margin: 0 auto; padding: 44px 36px; text-align: center; }
    .redeem-card > p, .redeem-result > p { color: var(--muted); line-height: 1.75; }
    .redeem-card > p { margin: 0 0 22px; }
    #claim-btn { margin-top: 4px; }
    .redeem-result { margin-top: 10px; }
    .redeem-result > p { margin: 0 0 20px; }
    .redeem-code { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: center; margin: 22px 0 26px; }
    .redeem-code code { padding: 14px 20px; border: 1px dashed var(--primary); border-radius: 10px; background: var(--primary-soft); color: var(--primary-on-soft); font-size: 20px; font-weight: 700; letter-spacing: .06em; }
    .redeem-note { font-size: 14px; }
    .redeem-play { margin-top: 22px; }
    .redeem-more { margin-top: 12px; }
    .redeem-error { margin: 20px 0 0; color: #B00020; font-weight: 600; }
    @media (max-width: 520px) { .redeem-card { padding: 34px 22px; } }
  </style>
</Layout>
