---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Redeem a promo code – Ascuta"
  description="Redeem a one-time Google Play promo code for Ascuta Lifetime Pro."
  noindex
>
  <section class="page-header"><div class="container"><p class="eyebrow">Promo code</p><h1>Redeem your Ascuta Pro code.</h1><p class="lede">Claim a one-time Google Play promo code for Lifetime Pro. One code per person.</p></div></section>
  <section class="section"><div class="container narrow">
    <div class="support-card redeem-card">
      <p id="intro">Tap the button to get your code. You redeem it through Google Play, so Lifetime Pro is tied to your Google account — no Ascuta account needed.</p>
      <button class="button button-primary" id="claim-btn" type="button">Get my promo code</button>
      <div class="redeem-result" id="result" hidden>
        <p>Your promo code</p>
        <div class="redeem-code"><code id="code-value"></code><button class="button button-secondary" id="copy-btn" type="button">Copy</button></div>
        <p class="redeem-note" id="already" hidden>You already claimed a code from this connection, so this is your original one.</p>
        <p>To redeem it, open the Google Play Store app, open the menu, choose <strong>Redeem code</strong>, and paste the code. Then open Ascuta — Lifetime Pro will be active.</p>
        <a class="button button-primary" href="https://play.google.com/redeem" target="_blank" rel="noopener">Open Google Play</a>
      </div>
      <p class="redeem-error" id="error" hidden></p>
    </div>
  </div></section>

  <script>
    const API = 'https://ascuta.viglianisi.ovh/api/redeem';
    const claimBtn = document.getElementById('claim-btn') as HTMLButtonElement | null;
    const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement | null;
    const result = document.getElementById('result');
    const codeValue = document.getElementById('code-value');
    const already = document.getElementById('already');
    const error = document.getElementById('error');
    const intro = document.getElementById('intro');

    function showError(message: string) {
      if (!error) return;
      error.textContent = message;
      error.hidden = false;
    }

    claimBtn?.addEventListener('click', async () => {
      claimBtn.disabled = true;
      claimBtn.textContent = 'Getting your code…';
      if (error) error.hidden = true;
      try {
        const response = await fetch(API, { method: 'POST' });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          showError(
            response.status === 404
              ? 'All promo codes have been claimed. Thanks for the interest!'
              : response.status === 429
                ? 'Too many attempts. Please wait a minute and try again.'
                : 'Something went wrong. Please try again in a moment.',
          );
          claimBtn.disabled = false;
          claimBtn.textContent = 'Try again';
          return;
        }
        if (codeValue) codeValue.textContent = data.code;
        if (already) already.hidden = !data.alreadyClaimed;
        if (result) result.hidden = false;
        claimBtn.hidden = true;
        if (intro) intro.hidden = true;
      } catch {
        showError('Cannot reach the server right now. Please try again in a moment.');
        claimBtn.disabled = false;
        claimBtn.textContent = 'Try again';
      }
    });

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(codeValue?.textContent ?? '');
        copyBtn.textContent = 'Copied';
        setTimeout(() => (copyBtn.textContent = 'Copy'), 2000);
      } catch {
        copyBtn.textContent = 'Select & copy';
      }
    });
  </script>

  <style>
    .redeem-card { text-align: center; }
    .redeem-card > p { color: var(--muted); line-height: 1.65; }
    .redeem-code { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: center; margin: 12px 0 22px; }
    .redeem-code code { padding: 12px 18px; border: 1px dashed var(--primary); border-radius: 10px; background: var(--primary-soft); color: var(--primary-on-soft); font-size: 20px; font-weight: 700; letter-spacing: .06em; }
    .redeem-result > p { color: var(--muted); }
    .redeem-note { font-size: 14px; }
    .redeem-error { color: #B00020; font-weight: 600; }
  </style>
</Layout>
