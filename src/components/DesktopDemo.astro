---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['desktop-visual', { compact }]} aria-hidden="true">
  <div class="window">
    <div class="titlebar">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="title">Weekly update — Notes</span>
      <span class="tray">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" d="M12 14a3 3 0 003-3V6a3 3 0 10-6 0v5a3 3 0 003 3zm6-3a6 6 0 01-12 0m6 6v3"/></svg>
      </span>
    </div>

    <div class="doc">
      <p>Hi Anna,</p>
      <p>Here is the summary you asked for. <span class="typed">The launch is on track for Thursday, and the final copy is already in review.</span><span class="caret"></span></p>
      <p class="dim">Let me know if you want anything added before we send it out.</p>
    </div>

    <div class="hud">
      <span class="mic">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 14a3 3 0 003-3V5a3 3 0 10-6 0v6a3 3 0 003 3zm5.3-3a5.3 5.3 0 01-10.6 0H5a7 7 0 006 6.92V21h2v-3.08A7 7 0 0019 11h-1.7z"/></svg>
      </span>
      <span class="wave"><i></i><i></i><i></i><i></i><i></i></span>
      <span class="label">Listening</span>
      <span class="keys"><kbd>Ctrl</kbd><b>+</b><kbd>Win</kbd></span>
    </div>
  </div>
</div>

<style>
  .desktop-visual {
    position: relative;
    padding: 16px 0;
  }

  .desktop-visual::before {
    content: '';
    position: absolute;
    inset: 5% -4% -4%;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 166, 251, .18), rgba(0, 166, 251, 0) 72%);
  }

  .window {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border: 1px solid #dbe6ee;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 28px 60px rgba(0, 53, 84, .16), 0 4px 14px rgba(0, 53, 84, .06);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-bottom: 1px solid #eef2f6;
    background: linear-gradient(#fbfdff, #f3f8fc);
  }

  .dots { display: flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: #d6e2ea; }
  .dots i:nth-child(1) { background: #ffd2ca; }
  .dots i:nth-child(2) { background: #ffe6b8; }
  .dots i:nth-child(3) { background: #c8ecd2; }

  .title {
    overflow: hidden;
    color: #7b8b98;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tray {
    display: flex;
    align-items: center;
    margin-left: auto;
    padding: 4px;
    border-radius: 6px;
    color: var(--primary);
    background: var(--primary-soft);
  }

  .doc {
    min-height: 252px;
    padding: 28px 30px 96px;
    color: #4a5a66;
    font-size: 15px;
    line-height: 1.7;
  }

  .doc p { margin: 0 0 14px; }
  .dim { color: #9aa9b4; }

  .typed {
    color: var(--ink);
    font-weight: 500;
    background: linear-gradient(transparent 64%, rgba(0, 166, 251, .2) 64%);
  }

  .caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -.18em;
    border-radius: 1px;
    background: var(--primary);
    animation: blink 1.1s steps(1) infinite;
  }

  .hud {
    position: absolute;
    bottom: 18px;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 13px 9px 9px;
    border: 1px solid #dfe9f0;
    border-radius: 999px;
    background: rgba(255, 255, 255, .95);
    box-shadow: 0 12px 28px rgba(0, 53, 84, .16);
    transform: translateX(-50%);
    backdrop-filter: blur(8px);
  }

  .mic {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: #fff;
    background: var(--primary);
  }

  .wave { display: flex; align-items: center; gap: 3px; height: 22px; }
  .wave i {
    width: 3px;
    height: 8px;
    border-radius: 2px;
    background: var(--primary);
    animation: level 1s ease-in-out infinite;
  }
  .wave i:nth-child(2) { height: 14px; animation-delay: .12s; }
  .wave i:nth-child(3) { height: 20px; animation-delay: .24s; }
  .wave i:nth-child(4) { height: 14px; animation-delay: .36s; }
  .wave i:nth-child(5) { height: 8px; animation-delay: .48s; }

  .label {
    color: var(--primary-dark);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .02em;
  }

  .keys { display: flex; align-items: center; gap: 4px; margin-left: 4px; }
  .keys b { color: #a8b7c2; font-size: 10px; font-weight: 600; }

  kbd {
    padding: 2px 5px;
    border: 1px solid #dbe6ee;
    border-bottom-width: 2px;
    border-radius: 5px;
    color: #5c7182;
    background: #f1f6fa;
    font-family: inherit;
    font-size: 10px;
    font-weight: 700;
  }

  .compact .doc {
    min-height: 208px;
    padding: 22px 24px 84px;
    font-size: 13.5px;
  }

  .compact .hud { bottom: 14px; }

  @media (max-width: 520px) {
    .doc { min-height: 224px; padding: 22px 22px 92px; font-size: 14px; }
    .title { display: none; }
    .keys { display: none; }
  }

  @keyframes blink { 50% { opacity: 0; } }
  @keyframes level {
    0%, 100% { transform: scaleY(.55); }
    50% { transform: scaleY(1); }
  }
</style>
