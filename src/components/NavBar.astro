---
interface Props { base: string }
const { base } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: `${base}desktop`, label: 'Desktop' },
  { href: `${base}docs`, label: 'Docs' },
];
const isCurrent = (href: string) => {
  const target = href.replace(/\/+$/, '') || '/';
  return pathname === target || pathname.startsWith(`${target}/`);
};
---
<nav class="site-nav">
  <div class="container nav-inner">
    <a href={base} class="brand" aria-label="Ascuta home">
      <img src={`${base}ascuta-logo.svg`} alt="" class="brand-logo" width="38" height="38" />
      <span>Ascuta</span>
    </a>
    <div class="nav-links">
      {links.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </div>
  </div>
</nav>
