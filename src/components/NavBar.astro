---
interface Props { base: string }
const { base } = Astro.props;
---
<nav class="site-nav">
  <div class="container nav-inner">
    <a href={base} class="brand" aria-label="Ascuta home">
      <img src={`${base}ascuta-logo.svg`} alt="" class="brand-logo" width="38" height="38" />
      <span>Ascuta</span>
    </a>
    <div class="nav-links">
      <a href={`${base}docs`}>Docs</a>
      <a href={`${base}pricing`}>Pricing</a>
    </div>
  </div>
</nav>
