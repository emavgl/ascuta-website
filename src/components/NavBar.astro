---
interface Props { base: string }
const { base } = Astro.props;
---
<nav class="border-b border-gray-200 bg-white">
  <div class="container nav-inner">
    <a href={base} class="brand" aria-label="VoiceFlow home">
      <img src={`${base}voiceflow-logo.svg`} alt="" class="brand-logo" width="38" height="38" />
      <span>VoiceFlow</span>
    </a>
    <div class="nav-links">
      <a href={`${base}support`}>Support</a>
      <a href={`${base}docs`}>Docs</a>
      <a href={`${base}privacy-policy`}>Privacy</a>
      <a href={`${base}terms`}>Terms</a>
    </div>
  </div>
</nav>
