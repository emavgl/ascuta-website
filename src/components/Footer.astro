---
interface Props { base: string }
const { base } = Astro.props;
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="footer-brand"><img src={`${base}ascuta-logo.svg`} alt="" class="brand-logo" width="32" height="32" /><span>Ascuta</span></div>
      <p class="footer-copy">Private, practical voice typing for Android.</p>
    </div>
    <div>
      <h2>Product</h2>
      <ul><li><a href={base}>Overview</a></li><li><a href={`${base}docs`}>Docs</a></li><li><a href={`${base}pricing`}>Pricing</a></li></ul>
    </div>
    <div>
      <h2>Legal</h2>
      <ul><li><a href={`${base}privacy-policy`}>Privacy policy</a></li><li><a href={`${base}terms`}>Terms &amp; conditions</a></li><li><a href={`${base}impressum`}>Impressum</a></li></ul>
    </div>
  </div>
  <div class="container footer-bottom">© {new Date().getFullYear()} · Ascuta</div>
</footer>
