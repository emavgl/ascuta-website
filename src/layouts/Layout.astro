---
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = 'Ascuta is private, practical voice typing for Android.', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Emanuele Viglianisi" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#0582CA" />
    <link rel="icon" type="image/svg+xml" href={`${base}ascuta-logo.svg`} />
    <link rel="stylesheet" href={`${base}styles.css`} />
    <title>{title}</title>
  </head>
  <body>
    <NavBar base={base} />
    <main><slot /></main>
    <Footer base={base} />
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #051923; background: #fff; }
</style>
